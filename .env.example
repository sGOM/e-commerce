# docker compose 환경변수 템플릿.
# 이 파일을 복사해 실제 값을 채운다:  cp .env.example .env
# .env 는 .gitignore 에 포함되어 커밋되지 않는다.

# ---- Database ----
POSTGRES_DB=starter
POSTGRES_USER=starter
POSTGRES_PASSWORD=starter

# ---- Backend ----
# 소셜 로그인을 쓰려면 local,oauth 로 지정한다. 기본은 local.
SPRING_PROFILES_ACTIVE=local

# ---- OAuth2 소셜 로그인 (SPRING_PROFILES_ACTIVE 에 oauth 포함 시에만 필요) ----
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=
KAKAO_CLIENT_ID=
KAKAO_CLIENT_SECRET=

# 로그인 성공/실패 후 이동 경로
OAUTH_SUCCESS_REDIRECT_URI=/
OAUTH_FAILURE_REDIRECT_URI=/login
