# docker compose 환경변수 템플릿.
# 이 파일을 복사해 실제 값을 채운다:  cp .env.example .env
# .env 는 .gitignore 에 포함되어 커밋되지 않는다.

# ---- Database ----
POSTGRES_DB=starter
POSTGRES_USER=starter
POSTGRES_PASSWORD=starter

# ---- Backend ----
# 소셜 로그인을 쓰려면 local,oauth 로 지정한다. 기본은 local.
SPRING_PROFILES_ACTIVE=local

# ---- OAuth2 소셜 로그인 (SPRING_PROFILES_ACTIVE 에 oauth 포함 시에만 필요) ----
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=
KAKAO_CLIENT_ID=
KAKAO_CLIENT_SECRET=

# 로그인 성공/실패 후 이동 경로
OAUTH_SUCCESS_REDIRECT_URI=/
OAUTH_FAILURE_REDIRECT_URI=/login

# ---- 결제 (기본 mock). 토스 실연동: 백엔드 toss + 시크릿, 프론트는 frontend/.env 에 VITE_TOSS_CLIENT_KEY ----
# 키는 토스 개발자센터 > API 개별 연동 키(결제창용). 웹훅 URL: https://<도메인>/api/payments/webhook/toss
PAYMENT_GATEWAY=mock
PAYMENT_TOSS_SECRETKEY=

# ---- 업로드 이미지 저장소 (기본 local 디스크). S3/MinIO 사용 시 ----
UPLOAD_STORAGE=local
UPLOAD_S3_BUCKET=
UPLOAD_S3_REGION=ap-northeast-2
# MinIO 등 S3 호환 저장소면 엔드포인트 지정(비우면 AWS S3)
UPLOAD_S3_ENDPOINT=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
